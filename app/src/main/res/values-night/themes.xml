<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night/Dark theme explicitly setting dark background and dark status bar -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/drg_background</item>
        <item name="android:colorBackground">@color/drg_background</item>
    </style>
</resources>
